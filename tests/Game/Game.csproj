<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Rifles.Game.Checks</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Check.cs" Link="Check.cs" />
    <Using Include="Rifles.Checks" />
    <ProjectReference Include="../../src/Rifles.Game/Rifles.Game.csproj" />
  </ItemGroup>
</Project>
