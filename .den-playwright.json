{
  "project": "rusty-rifles",
  "serve": {
    "command": "PATH=\"$HOME/.local/bin:$PATH\" exec rusty dev --project src/Rifles.Game/Rifles.Game.csproj --live-debug --bind-host {host} --port {port}",
    "healthUrl": "/",
    "readyText": "<title>Rusty Product Host</title>",
    "reusePolicy": "broker_owned",
    "startupTimeout": "120s",
    "healthInterval": "250ms"
  },
  "playtest": {
    "startPath": "/",
    "viewport": {
      "width": 1280,
      "height": 720
    },
    "headed": false,
    "recordVideo": false
  }
}
