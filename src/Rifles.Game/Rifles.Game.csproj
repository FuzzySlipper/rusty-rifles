<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineSdkPackageVersion>0.1.0-dev.03ac310b95c2</RustyEngineSdkPackageVersion>
    <RustyEngineProductEntryType>Rifles.Game.RiflesProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-rifles</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Rifles</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui/generated/source'))</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>rifles.session</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rifles.session.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductDefaultWorldLights>disabled</RustyEngineProductDefaultWorldLights>
    <RustyEngineProductDefaultViewmodelLights>neutral</RustyEngineProductDefaultViewmodelLights>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineWatchPaths>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../ui'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Rifles.Procgen'));$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineWatchPaths>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rifles.Procgen/Rifles.Procgen.csproj" />
    <PackageReference Include="Rusty.Engine" Version="[$(RustyEngineSdkPackageVersion)]" />
    <RustyEngineContentBundle Include="generated-art" Root="art/generated" />
    <RustyEngineContentBundle Include="game-audio" Root="audio" />
    <RustyEngineProductInputIntent Include="rifles.use" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.use.keyboard" Intent="rifles.use" Trigger="key:key-f:pressed" />
    <RustyEngineProductInputIntent Include="rifles.cycle" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.cycle.keyboard" Intent="rifles.cycle" Trigger="key:key-r:pressed" />
    <RustyEngineProductInputIntent Include="rifles.command" Value="payload:rifles.command.v1" />
    <RustyEngineProductInputIntent Include="rifles.pause" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.pause.keyboard" Intent="rifles.pause" Trigger="key:key-p:pressed" />
    <RustyEngineProductInputIntent Include="rifles.save" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.save.keyboard" Intent="rifles.save" Trigger="key:key-k:pressed" />
    <RustyEngineProductInputIntent Include="rifles.load" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.load.keyboard" Intent="rifles.load" Trigger="key:key-l:pressed" />
    <RustyEngineProductInputIntent Include="rifles.attack" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.attack.keyboard" Intent="rifles.attack" Trigger="key:space:pressed" />
    <RustyEngineProductInputIntent Include="rifles.reload" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.reload.keyboard" Intent="rifles.reload" Trigger="key:key-t:pressed" />
    <!-- Press edges retain short taps between simulation steps; held mappings repeat movement. -->
    <RustyEngineProductInputIntent Include="rifles.forward" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.forward.keyboard" Intent="rifles.forward" Trigger="key:key-w:held" />
    <RustyEngineProductInputMapping Include="rifles.forward.press" Intent="rifles.forward" Trigger="key:key-w:pressed" />
    <RustyEngineProductInputIntent Include="rifles.backward" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.backward.keyboard" Intent="rifles.backward" Trigger="key:key-s:held" />
    <RustyEngineProductInputMapping Include="rifles.backward.press" Intent="rifles.backward" Trigger="key:key-s:pressed" />
    <RustyEngineProductInputIntent Include="rifles.strafe-left" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.strafe-left.keyboard" Intent="rifles.strafe-left" Trigger="key:key-a:held" />
    <RustyEngineProductInputMapping Include="rifles.strafe-left.press" Intent="rifles.strafe-left" Trigger="key:key-a:pressed" />
    <RustyEngineProductInputIntent Include="rifles.strafe-right" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.strafe-right.keyboard" Intent="rifles.strafe-right" Trigger="key:key-d:held" />
    <RustyEngineProductInputMapping Include="rifles.strafe-right.press" Intent="rifles.strafe-right" Trigger="key:key-d:pressed" />
    <RustyEngineProductInputIntent Include="rifles.turn-left" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.turn-left.keyboard" Intent="rifles.turn-left" Trigger="key:key-q:held" />
    <RustyEngineProductInputMapping Include="rifles.turn-left.press" Intent="rifles.turn-left" Trigger="key:key-q:pressed" />
    <RustyEngineProductInputIntent Include="rifles.turn-right" Value="digital" />
    <RustyEngineProductInputMapping Include="rifles.turn-right.keyboard" Intent="rifles.turn-right" Trigger="key:key-e:held" />
    <RustyEngineProductInputMapping Include="rifles.turn-right.press" Intent="rifles.turn-right" Trigger="key:key-e:pressed" />
  </ItemGroup>
  <Target Name="BuildRiflesUi" BeforeTargets="GenerateRustyEngineProductComposition">
    <Exec Command="pnpm --dir &quot;$(MSBuildThisFileDirectory)../..&quot; exec tsc --project &quot;$(MSBuildThisFileDirectory)../ui/tsconfig.json&quot;" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../content/art/generated/items/ink-wash-items-atlas.png" DestinationFiles="$(RustyEngineProductUiRoot)/items.png" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../content/art/generated/ui/bar-backdrop.png" DestinationFiles="$(RustyEngineProductUiRoot)/bar-backdrop.png" />
  </Target>
</Project>
